# Server-side Convex variables. Set with `npx convex env set --from-file <file>`.
AUTH_JWT_SECRET=
PROVIDER_MODE=fixture
INFERENCE_EVENT_URL=
INFERENCE_EVENT_TOKEN=
APIFY_TOKEN=
PROVIDER_AUTHORIZATION_APPROVED=false
RETENTION_POLICY_REF=
MAX_GRAPH_BYTES=500000
MAX_COMMENTS=1000
MAX_REQUEST_BYTES=500000
MAX_ACTIVE_JOBS=4
MAX_QUEUED_JOBS=100
POSTS_PER_HOUR=30
MAX_JOB_ATTEMPTS=3
APIFY_TIMEOUT_SECONDS=180
HISTORY_CACHE_SECONDS=3600
APIFY_RUN_BUDGET_CENTS=25
APIFY_DAILY_BUDGET_CENTS=500
LOCAL_SYNTHETIC_EVENT_DELIVERY=false
