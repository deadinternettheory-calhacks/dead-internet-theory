{
  "manifest_version": 3,
  "name": "Dead Internet Theory",
  "version": "1.0.1",
  "description": "Inspect public social discussions for coordinated promotion, beside the original post.",
  "minimum_chrome_version": "123",
  "key": "",
  "permissions": [
    "activeTab",
    "tabs",
    "sidePanel",
    "contextMenus",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.deadinternettheory.us/*"
  ],
  "action": {
    "default_title": "Analyze this post with Dead Internet Theory"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/ghost-16.png",
    "48": "icons/ghost-48.png",
    "128": "icons/ghost-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Dead Internet Theory for the current post"
    }
  }
}
